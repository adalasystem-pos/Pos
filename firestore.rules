rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Counters Collection: Daily atomic order sequence counters
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource.data.sequence is int || request.resource.data.sequence is number)
        && request.resource.data.sequence > 0;
    }

    // Products Collection: Menu items, pricing, portions, and availability status
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.name is string
        && (request.resource.data.price is int || request.resource.data.price is number)
        && request.resource.data.price > 0;
      allow update: if isAuthenticated();
      allow delete: if false; // Products should be disabled (active: false) rather than deleted to preserve referential integrity
    }

    // Orders Collection: Real-time orders, restaurant operations lifecycle, and POS receipts
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.status == 'preparing' || request.resource.data.status == 'completed')
        && (request.resource.data.totalAmount is int || request.resource.data.totalAmount is number)
        && request.resource.data.totalAmount > 0
        && request.resource.data.items.size() > 0;
      allow update: if isAuthenticated()
        && request.resource.data.status in ['preparing', 'ready', 'served', 'completed', 'cancelled'];
      allow delete: if false; // Immutable financial record - cancelled orders remain for audit
    }

    // Expenses Collection: Restaurant daily operational costs
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.amount is int || request.resource.data.amount is number)
        && request.resource.data.amount > 0
        && request.resource.data.category is string;
      allow update, delete: if false; // Immutable operational expense record
    }

    // Daily Closings Collection: Immutable end-of-day register closure
    match /dailyClosings/{businessDate} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.status == 'closed'
        && (request.resource.data.totalSales is int || request.resource.data.totalSales is number)
        && (request.resource.data.totalExpenses is int || request.resource.data.totalExpenses is number)
        && (request.resource.data.netProfit is int || request.resource.data.netProfit is number);
      allow update, delete: if false; // Cannot overwrite existing closed register
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
