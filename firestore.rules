rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Orders Collection: Real-time orders and POS receipts
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.totalAmount is int
        && request.resource.data.totalAmount > 0
        && request.resource.data.items.size() > 0;
      allow update, delete: if false; // Immutable financial record
    }

    // Expenses Collection: Restaurant daily operational costs
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.category is string;
      allow update, delete: if false; // Immutable operational expense record
    }

    // Daily Closings Collection: Immutable end-of-day register closure
    match /dailyClosings/{businessDate} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.status == 'closed'
        && request.resource.data.totalSales is int
        && request.resource.data.totalExpenses is int
        && request.resource.data.netProfit is int;
      allow update, delete: if false; // Cannot overwrite existing closed register
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
